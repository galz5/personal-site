---
import { person } from "@/data/home";
---

<section
  id="hero"
  class="mx-auto flex max-w-[1120px] flex-col items-center gap-10 px-6 py-16 sm:px-16 sm:py-24 md:flex-row md:items-center md:gap-14 md:py-[100px]"
>
  <div
    class="flex h-[180px] w-[180px] shrink-0 items-center justify-center rounded-full border border-border"
    style="background-image: repeating-linear-gradient(135deg, var(--stripe-a) 0px, var(--stripe-a) 10px, var(--stripe-b) 10px, var(--stripe-b) 20px);"
  >
    <span class="rounded bg-card px-2 py-1 font-mono text-[11px] text-muted-foreground">headshot</span>
  </div>
  <div class="text-center md:text-left">
    <h1 class="mb-2.5 font-serif text-[46px] leading-[1.1] font-semibold tracking-[-0.01em]">
      {person.name}
    </h1>
    <p class="mb-[22px] text-[19px] font-medium text-primary">{person.role}</p>
    <p class="mx-auto max-w-[560px] text-base leading-[1.65] text-muted-foreground md:mx-0">
      {person.bio}
    </p>
  </div>
</section>
