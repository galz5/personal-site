---
import { writingPosts } from "@/data/home";
---

<section id="writing" class="mx-auto max-w-[900px] px-6 pt-6 pb-[72px] sm:px-16">
  <h2 class="mb-9 font-serif text-2xl font-semibold">Writing</h2>
  <div class="flex flex-col gap-[22px]">
    {
      writingPosts.map((post) => (
        <a
          href={post.href}
          class="flex flex-col gap-1 text-foreground sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
        >
          <span class="text-base font-medium">
            {post.title}
            <span class="text-[13px] font-normal text-muted-foreground"> — {post.platform}</span>
          </span>
          <span class="shrink-0 text-sm whitespace-nowrap text-muted-foreground">{post.date}</span>
        </a>
      ))
    }
  </div>
</section>
