---
import { publications } from "@/data/home";
---

<section id="research" class="mx-auto max-w-[900px] px-6 pt-16 pb-6 sm:px-16">
  <h2 class="mb-9 font-serif text-2xl font-semibold">Publications</h2>
  <div class="flex flex-col gap-[30px]">
    {
      publications.map((pub) => (
        <div class="flex flex-col gap-2 border-b border-border pb-[26px] sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
          <div>
            <div class="mb-1.5 text-[17px] font-semibold">{pub.title}</div>
            <div class="mb-2 text-sm text-muted-foreground">{pub.venue}</div>
            <div class="max-w-[600px] text-[15px] leading-[1.5] text-muted-foreground">{pub.summary}</div>
          </div>
          <a href={pub.href} class="shrink-0 text-sm whitespace-nowrap text-primary">
            Read →
          </a>
        </div>
      ))
    }
  </div>
</section>
